<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/md_theme_primaryFixed">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white_transparent"
            android:elevation="4dp"
            app:title="@string/app_name"
            app:menu="@menu/top_app_bar">
        </androidx.appcompat.widget.Toolbar>


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">


            <!-- TextView to describe the total time -->
            <TextView
                android:id="@+id/textViewTimeDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/total_time_accumulated"
                android:textSize="14sp"
                android:textColor="@color/md_theme_onPrimaryFixedVariant"
                app:layout_constraintBottom_toTopOf="@id/textViewTotalTime"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginBottom="@dimen/margin_tiny"
                android:gravity="center"/>

            <!-- TextView to show the total time accumulated -->
            <TextView
                android:id="@+id/textViewTotalTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00:00"
                android:textSize="24sp"
                android:textColor="@color/md_theme_onPrimaryFixedVariant"
                android:layout_marginBottom="@dimen/margin_large"
                app:layout_constraintBottom_toTopOf="@id/circularProgressIndicator"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:gravity="center"/>

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/circularProgressIndicator"
                android:layout_width="300dp"
                android:layout_height="200dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_margin="@dimen/margin_medium"
                android:max="100"
                app:indicatorSize="300dp"
                app:trackThickness="@dimen/size_medium"
                android:progress="75"
                />


            <!-- NumberPickers for Hours, Minutes, and Seconds -->
            <LinearLayout
                android:id="@+id/numberPickerLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- NumberPicker for Hours -->
                <NumberPicker
                    android:id="@+id/numberPickerHours"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minValue="0"
                    android:maxValue="23"
                    android:value="0"
                    android:wrapSelectorWheel="false"
                    android:layout_marginEnd="16dp" />

                <!-- NumberPicker for Minutes -->
                <NumberPicker
                    android:id="@+id/numberPickerMinutes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minValue="0"
                    android:maxValue="59"
                    android:value="0"
                    android:wrapSelectorWheel="false"
                    android:layout_marginEnd="16dp"
                    />

                <!-- NumberPicker for Seconds -->
                <NumberPicker
                    android:id="@+id/numberPickerSeconds"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minValue="0"
                    android:maxValue="59"
                    android:value="0"
                    android:wrapSelectorWheel="false"
                    />
            </LinearLayout>


            <LinearLayout
                android:id="@+id/controlsLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/numberPickerLayout"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="80dp">

                <Button
                    android:id="@+id/startButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Start"
                    android:visibility="visible"/>

                <Button
                    android:id="@+id/stopButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stop"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:visibility="gone"/>

                <Button
                    android:id="@+id/resetButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reset"
                    android:visibility="gone"/>
            </LinearLayout>

            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/bottom_navigation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white_transparent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:menu="@menu/bottom_navigation_menu" />

            <!-- Floating Action Button to switch modes -->
            <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                android:id="@+id/fab_set_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Timer"
                app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_margin="16dp"
                android:minHeight="48dp"
                android:minWidth="90dp"
                android:backgroundTint="@color/md_theme_primary"
                android:textColor="@android:color/white"
                android:elevation="8dp" />



        </androidx.constraintlayout.widget.ConstraintLayout>



    </FrameLayout>


</layout>